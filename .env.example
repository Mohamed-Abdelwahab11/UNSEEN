# UNSEEN Environment Configuration Template
# Copy this file to .env and configure local paths and parameters.
# DO NOT commit real secrets or credentials to version control.

# Global Experiment Settings
UNSEEN_RANDOM_SEED=42
UNSEEN_LOG_LEVEL=INFO
UNSEEN_ENV=development

# Storage & Cache Directories
UNSEEN_DATA_DIR=./data
UNSEEN_RAW_DATA_DIR=./data/raw
UNSEEN_INTERIM_DATA_DIR=./data/interim
UNSEEN_PROCESSED_DATA_DIR=./data/processed
UNSEEN_MODELS_DIR=./models
UNSEEN_REPORTS_DIR=./reports

# Ground-Truth Event Source Endpoints / Paths
EMDAT_DATA_PATH=./data/raw/emdat_disasters.csv
GDACS_API_ENDPOINT=https://www.gdacs.org/xml/rss.xml
RELIEFWEB_API_ENDPOINT=https://api.reliefweb.int/v1/disasters

# Optional External News Data / API Configuration
# Populate only if fetching news through official APIs
NEWS_API_KEY=
MEDIA_CLOUD_API_KEY=
EVENT_REGISTRY_API_KEY=
